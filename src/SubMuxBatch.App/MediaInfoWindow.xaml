<Window x:Class="SubMuxBatch.App.MediaInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SubMuxBatch.App.Localization"
        Width="820"
        Height="600"
        MinWidth="640"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#F3F3F3"
        Foreground="#201F1E"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Win10DialogStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="DetailExpanderStyle" TargetType="Expander">
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="#D1D1D1" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Margin" Value="0,0,0,10" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <ToggleButton x:Name="HeaderToggle"
                                                  Grid.Row="0"
                                                  Height="38"
                                                  Padding="14,0"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Content="{TemplateBinding Header}"
                                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                  FocusVisualStyle="{x:Null}"
                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="HeaderSurface"
                                                        Background="{TemplateBinding Background}">
                                                    <Grid Margin="{TemplateBinding Padding}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <ContentPresenter Grid.Column="0"
                                                                          VerticalAlignment="Center"
                                                                          Content="{TemplateBinding Content}"
                                                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                                                        <Path x:Name="Chevron"
                                                              Grid.Column="1"
                                                              Width="10"
                                                              Height="6"
                                                              Margin="14,0,1,0"
                                                              HorizontalAlignment="Right"
                                                              VerticalAlignment="Center"
                                                              Data="M 1 1 L 5 5 L 9 1"
                                                              Fill="Transparent"
                                                              Stroke="#605E5C"
                                                              StrokeThickness="1.4"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              RenderTransformOrigin="0.5,0.5">
                                                            <Path.RenderTransform>
                                                                <RotateTransform Angle="0" />
                                                            </Path.RenderTransform>
                                                        </Path>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="HeaderSurface" Property="Background" Value="#F7F7F7" />
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Chevron" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="180" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter x:Name="ExpandedContent"
                                                      Grid.Row="1"
                                                      Visibility="Collapsed"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="MediaInfoTabRadioStyle" TargetType="RadioButton">
                <Setter Property="MinWidth" Value="92" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="Background" Value="White" />
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="TabSurface"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabSurface" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="TabSurface" Property="Background" Value="{StaticResource SelectionBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="MediaSizeSummaryLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Style>
            <Style x:Key="MediaSizeSummaryValueStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,3,0,0" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Padding="20,15,20,9" Background="White"
                BorderBrush="#D1D1D1" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock x:Name="HeadingText"
                           Text="{loc:Loc MediaDetails_Heading}"
                           FontSize="21"
                           FontWeight="SemiBold"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <Grid Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Margin="0,0,16,0"
                               VerticalAlignment="Center"
                               Text="{loc:Loc MediaDetails_Description}"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="1"
                            VerticalAlignment="Center"
                            BorderBrush="{StaticResource StrongBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="MediaInfoTabButton"
                                         Content="{loc:Loc MediaSizes_InfoTab}"
                                         GroupName="MediaInfoView"
                                         IsChecked="True"
                                         Style="{StaticResource MediaInfoTabRadioStyle}"
                                         Checked="MediaInfoView_Checked" />
                            <Border Width="1" Background="{StaticResource BorderBrush}" />
                            <RadioButton x:Name="TrackSizesTabButton"
                                         Content="{loc:Loc MediaSizes_TabTitle}"
                                         GroupName="MediaInfoView"
                                         Style="{StaticResource MediaInfoTabRadioStyle}"
                                         Checked="MediaInfoView_Checked" />
                        </StackPanel>
                    </Border>
                </Grid>
                <TextBlock Margin="0,6,0,0"
                           Text="{loc:Loc MediaDetails_ProcessedBySubMux}"
                           Foreground="#107C10"
                           FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsProcessedBySubMux}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="GeneralInfoPanel" Grid.Row="1" Padding="16" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Margin="0,0,0,10" Padding="14,11" Background="White"
                        BorderBrush="#D1D1D1" BorderThickness="1" CornerRadius="2">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc MediaDetails_Path}" FontWeight="SemiBold" />
                        <TextBlock Margin="0,5,0,0" Text="{Binding Path}" ToolTip="{Binding Path}"
                                   TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander Style="{StaticResource DetailExpanderStyle}"
                                      IsExpanded="{Binding IsExpanded, Mode=OneTime}">
                                <Expander.Header>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                </Expander.Header>
                                <ItemsControl Margin="12,0,12,10" ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E8E8E8" BorderThickness="0,1,0,0">
                                                <Grid Margin="2,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="175" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Padding="6,7" Text="{Binding Label}"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="1" Padding="6,7" Text="{Binding Value}"
                                                               TextWrapping="Wrap" TextTrimming="None" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="TrackSizesPanel" Grid.Row="1" Margin="16" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="{loc:Loc MediaSizes_Description}" FontWeight="SemiBold" />
                <TextBlock Margin="0,4,0,0"
                           Text="{Binding SizeStatusText}"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="1" Margin="0,0,0,10" Padding="14,10"
                    Background="White" BorderBrush="#D1D1D1" BorderThickness="1" CornerRadius="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{loc:Loc MediaSizes_TotalFileSize}" Style="{StaticResource MediaSizeSummaryLabelStyle}" />
                        <TextBlock Text="{Binding TotalFileSizeText}" Style="{StaticResource MediaSizeSummaryValueStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <TextBlock Text="{loc:Loc MediaSizes_VideoTotal}" Style="{StaticResource MediaSizeSummaryLabelStyle}" />
                        <TextBlock Text="{Binding VideoSizeText}" Style="{StaticResource MediaSizeSummaryValueStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="16,0,0,0">
                        <TextBlock Text="{loc:Loc MediaSizes_AudioTotal}" Style="{StaticResource MediaSizeSummaryLabelStyle}" />
                        <TextBlock Text="{Binding AudioSizeText}" Style="{StaticResource MediaSizeSummaryValueStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="16,0,0,0">
                        <TextBlock Text="{loc:Loc MediaSizes_SubtitleAttachmentTotal}" Style="{StaticResource MediaSizeSummaryLabelStyle}" />
                        <TextBlock Text="{Binding SubtitleAttachmentSizeText}" Style="{StaticResource MediaSizeSummaryValueStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" Margin="16,0,0,0">
                        <TextBlock Text="{loc:Loc MediaSizes_OverheadSize}" Style="{StaticResource MediaSizeSummaryLabelStyle}" />
                        <TextBlock Text="{Binding ContainerOverheadText}" Style="{StaticResource MediaSizeSummaryValueStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="White" BorderBrush="#D1D1D1" BorderThickness="1" CornerRadius="2">
                <Grid Grid.IsSharedSizeScope="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="10,6" BorderBrush="#D1D1D1" BorderThickness="0,0,0,1">
                        <Grid>
                            <TextBlock VerticalAlignment="Center"
                                       Text="{loc:Loc MediaSizes_Breakdown}"
                                       FontWeight="SemiBold" />
                            <Button HorizontalAlignment="Right"
                                    Margin="0"
                                    Padding="10,3"
                                    MinHeight="28"
                                    Content="{loc:Loc MediaSizes_Calculate}"
                                    IsEnabled="{Binding CanCalculateExactSizes}"
                                    Click="CalculateExactSizesButton_Click" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Padding="10,7" Background="#F7F7F7" BorderBrush="#D1D1D1" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc MediaSizes_Item}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{loc:Loc MediaSizes_Details}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="{loc:Loc MediaSizes_Size}" FontWeight="SemiBold" TextAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="{loc:Loc MediaSizes_Share}" FontWeight="SemiBold" TextAlignment="Right" />
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding SizeRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="64" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                <TextBlock Margin="0,2,0,0" Text="{Binding Category}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Text="{Binding Details}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Details}" />
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center" Text="{Binding Size}" ToolTip="{Binding SizeToolTip}" />
                                                <Border Margin="7,0,0,0" Padding="4,1" Background="#F0F0F0" CornerRadius="2">
                                                    <TextBlock Text="{Binding Basis}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{Binding Share}" TextAlignment="Right" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <ProgressBar Grid.Row="3" Height="4" Margin="0,10,0,0" IsIndeterminate="True">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCalculatingSizes}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
        </Grid>

        <Border Grid.Row="2" Padding="16,10" Background="White"
                BorderBrush="#D1D1D1" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Margin="0" Content="{loc:Loc MediaDetails_CopyAll}"
                        Click="CopyAllButton_Click" />
                <Button Grid.Column="2" Margin="0" Content="{loc:Loc Common_Close}"
                        Click="CloseButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
