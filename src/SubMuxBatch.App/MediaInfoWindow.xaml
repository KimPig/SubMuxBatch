<Window x:Class="SubMuxBatch.App.MediaInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SubMuxBatch.App.Localization"
        Width="780"
        Height="520"
        MinWidth="620"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#F3F3F3"
        Foreground="#201F1E"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary Source="Win10DialogStyles.xaml" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="20,15"
                Background="White"
                BorderBrush="#D1D1D1"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock x:Name="HeadingText"
                           Text="{loc:Loc MediaDetails_Heading}"
                           FontSize="21"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,3,0,0"
                           Text="{loc:Loc MediaDetails_Description}"
                           Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      Padding="16"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Margin="0,0,0,10"
                        Padding="14,11"
                        Background="White"
                        BorderBrush="#D1D1D1"
                        BorderThickness="1"
                        CornerRadius="2">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc MediaDetails_Path}" FontWeight="SemiBold" />
                        <TextBlock Margin="0,5,0,0"
                                   Text="{Binding MediaDetailsPath}"
                                   ToolTip="{Binding MediaDetailsPath}"
                                   TextWrapping="Wrap"
                                   FontFamily="Consolas"
                                   FontSize="12" />
                    </StackPanel>
                </Border>

                <Border Margin="0,0,0,10"
                        Padding="14,11"
                        Background="White"
                        BorderBrush="#D1D1D1"
                        BorderThickness="1"
                        CornerRadius="2">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc MediaDetails_General}" FontWeight="SemiBold" />
                        <TextBlock Margin="0,5,0,0"
                                   Text="{Binding MediaDetailsInputSummary}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Margin="0,0,0,10"
                        Padding="14,11"
                        Background="White"
                        BorderBrush="#D1D1D1"
                        BorderThickness="1"
                        CornerRadius="2">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc MediaDetails_Video}" FontWeight="SemiBold" />
                        <TextBlock Margin="0,5,0,0"
                                   Text="{Binding MediaDetailsVideoSummary}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Margin="0,0,0,10"
                        Padding="14,11"
                        Background="White"
                        BorderBrush="#D1D1D1"
                        BorderThickness="1"
                        CornerRadius="2">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc MediaDetails_Audio}" FontWeight="SemiBold" />
                        <TextBlock Margin="0,5,0,0"
                                   Text="{Binding MediaDetailsAudioSummary}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Margin="0,0,0,10"
                        Padding="14,11"
                        Background="White"
                        BorderBrush="#D1D1D1"
                        BorderThickness="1"
                        CornerRadius="2">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc MediaDetails_Subtitles}" FontWeight="SemiBold" />
                        <TextBlock Margin="0,5,0,0"
                                   Text="{Binding MediaDetailsSubtitleSummary}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Padding="14,11"
                        Background="White"
                        BorderBrush="#D1D1D1"
                        BorderThickness="1"
                        CornerRadius="2">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc MediaDetails_Structure}" FontWeight="SemiBold" />
                        <TextBlock Margin="0,5,0,0"
                                   Text="{Binding MediaDetailsStructureSummary}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Padding="16,10"
                Background="White"
                BorderBrush="#D1D1D1"
                BorderThickness="0,1,0,0">
            <Button HorizontalAlignment="Right"
                    Margin="0"
                    Content="{loc:Loc Common_Close}"
                    Click="CloseButton_Click" />
        </Border>
    </Grid>
</Window>
