<Window x:Class="SubMuxBatch.App.PresetNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SubMuxBatch.App.Localization"
        Width="420"
        SizeToContent="Height"
        MinWidth="360"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F3F3F3"
        Foreground="#201F1E"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Win10DialogStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{loc:Loc Preset_NamePrompt}"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap" />
        <TextBox x:Name="NameTextBox"
                 Grid.Row="1"
                 Margin="0,10,0,18"
                 MinHeight="34"
                 MaxLength="80"
                 VerticalContentAlignment="Center"
                 Style="{StaticResource FluentTextBoxStyle}"
                 KeyDown="NameTextBox_KeyDown" />
        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Content="{loc:Loc Common_Save}"
                    IsDefault="True"
                    Click="Save_Click" />
            <Button Margin="0"
                    Content="{loc:Loc Common_Cancel}"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
