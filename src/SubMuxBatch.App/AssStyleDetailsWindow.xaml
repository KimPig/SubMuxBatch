<Window x:Class="SubMuxBatch.App.AssStyleDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ASS 스타일 상세 설정"
        Width="760"
        Height="680"
        MinWidth="620"
        MinHeight="500"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#F3F3F3"
        Foreground="#201F1E"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Win10DialogStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="FieldTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource FluentTextBoxStyle}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="FieldComboBoxStyle"
               TargetType="ComboBox"
               BasedOn="{StaticResource FluentComboBoxStyle}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="FieldContainerStyle" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="22,18"
                Background="White"
                BorderBrush="#D1D1D1"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="ASS 스타일"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,18,0"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               Text="자주 쓰는 필드만 편집합니다. 표시되지 않은 Style 필드는 그대로 보존됩니다." />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Style 수동 입력"
                        Margin="0"
                        VerticalAlignment="Center"
                        Click="OpenManualStyleInput_Click" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      Padding="18,16,6,16"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Border Padding="18"
                    Background="White"
                    BorderBrush="#D1D1D1"
                    BorderThickness="1"
                    CornerRadius="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Style="{StaticResource FieldContainerStyle}">
                        <TextBlock Text="PlayResX" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="PlayResXTextBox" Style="{StaticResource FieldTextBoxStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Style="{StaticResource FieldContainerStyle}">
                        <TextBlock Text="PlayResY" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="PlayResYTextBox" Style="{StaticResource FieldTextBoxStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Style="{StaticResource FieldContainerStyle}">
                        <TextBlock Text="폰트 이름" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="FontNameTextBox" Style="{StaticResource FieldTextBoxStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Style="{StaticResource FieldContainerStyle}">
                        <TextBlock Text="폰트 크기" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="FontSizeTextBox" Style="{StaticResource FieldTextBoxStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Style="{StaticResource FieldContainerStyle}">
                        <TextBlock Text="글자색 (Primary)" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="PrimaryColorTextBox" Style="{StaticResource FieldTextBoxStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2" Style="{StaticResource FieldContainerStyle}">
                        <TextBlock Text="외곽선색" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="OutlineColorTextBox" Style="{StaticResource FieldTextBoxStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Row="3"
                                Grid.ColumnSpan="3"
                                Style="{StaticResource FieldContainerStyle}">
                        <TextBlock Text="그림자/배경색 (Back)" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="BackColorTextBox" Style="{StaticResource FieldTextBoxStyle}" />
                        <TextBlock Margin="0,5,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="12"
                                   Text="ASS 색상 형식: &amp;HAABBGGRR" />
                    </StackPanel>

                    <StackPanel Grid.Row="4" Style="{StaticResource FieldContainerStyle}">
                        <TextBlock Text="외곽선 두께" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="OutlineWidthTextBox" Style="{StaticResource FieldTextBoxStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="2" Style="{StaticResource FieldContainerStyle}">
                        <TextBlock Text="그림자 깊이" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="ShadowDepthTextBox" Style="{StaticResource FieldTextBoxStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Row="5" Style="{StaticResource FieldContainerStyle}">
                        <TextBlock Text="정렬 (1~9)" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox x:Name="AlignmentComboBox" Style="{StaticResource FieldComboBoxStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Row="5" Grid.Column="2" Style="{StaticResource FieldContainerStyle}">
                        <TextBlock Text="수직 여백" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="MarginVerticalTextBox" Style="{StaticResource FieldTextBoxStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Row="6" Style="{StaticResource FieldContainerStyle}">
                        <TextBlock Text="좌측 여백" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="MarginLeftTextBox" Style="{StaticResource FieldTextBoxStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Row="6" Grid.Column="2" Style="{StaticResource FieldContainerStyle}">
                        <TextBlock Text="우측 여백" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="MarginRightTextBox" Style="{StaticResource FieldTextBoxStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Row="7"
                                Grid.ColumnSpan="3"
                                Orientation="Horizontal">
                        <CheckBox x:Name="BoldCheckBox"
                                  Content="굵게"
                                  Margin="0,2,28,0" />
                        <CheckBox x:Name="ItalicCheckBox"
                                  Content="기울임"
                                  Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </ScrollViewer>

        <Border Grid.Row="2"
                Padding="18,14"
                Background="White"
                BorderBrush="#D1D1D1"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="취소" IsCancel="True" />
                <Button Content="확인"
                        Margin="0"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="SaveButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
