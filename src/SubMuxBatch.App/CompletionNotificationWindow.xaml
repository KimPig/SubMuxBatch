<Window x:Class="SubMuxBatch.App.CompletionNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SubMuxBatch.App.Localization"
        Title="SubMux Batch"
        Width="396"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Opacity="0"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="NotificationCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2">
                            <Path Width="9"
                                  Height="9"
                                  Stretch="Fill"
                                  Stroke="#5A5A5A"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Square"
                                  StrokeEndLineCap="Square"
                                  Data="M 0.5,0.5 L 8.5,8.5 M 8.5,0.5 L 0.5,8.5"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseSurface" Property="Background" Value="#E5E5E5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloseSurface" Property="Background" Value="#CCCCCC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid x:Name="AnimationRoot"
          Margin="9"
          Cursor="Hand"
          RenderTransformOrigin="0.5,0.5"
          MouseEnter="Notification_MouseEnter"
          MouseLeave="Notification_MouseLeave"
          MouseLeftButtonUp="Notification_MouseLeftButtonUp">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" Y="8" />
        </Grid.RenderTransform>

        <Border Background="#FAFAFA"
                BorderBrush="#C8C8C8"
                BorderThickness="1"
                CornerRadius="3">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12"
                                  ShadowDepth="2"
                                  Direction="270"
                                  Color="#40000000"
                                  Opacity="0.22" />
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="38" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="AccentBar"
                        Grid.RowSpan="3"
                        Grid.Column="0"
                        CornerRadius="2,0,0,2" />

                <TextBlock Grid.Row="0"
                           Grid.Column="1"
                           Grid.ColumnSpan="2"
                           Margin="12,9,0,0"
                           Foreground="#666666"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Text="SubMux Batch"
                           VerticalAlignment="Top" />

                <Button Grid.Row="0"
                        Grid.Column="3"
                        Style="{StaticResource NotificationCloseButtonStyle}"
                        Margin="3,3,7,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        ToolTip="{loc:Loc Common_Close}"
                        Click="CloseButton_Click" />

                <Border x:Name="StatusBadge"
                        Grid.Row="1"
                        Grid.RowSpan="2"
                        Grid.Column="1"
                        Width="32"
                        Height="32"
                        Margin="12,4,8,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        CornerRadius="2">
                    <Path x:Name="StatusGlyph"
                          Width="16"
                          Height="16"
                          Stretch="Uniform"
                          StrokeThickness="1.8"
                          StrokeStartLineCap="Square"
                          StrokeEndLineCap="Square"
                          StrokeLineJoin="Miter"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Border>

                <TextBlock x:Name="TitleText"
                           Grid.Row="1"
                           Grid.Column="2"
                           Margin="0,1,12,0"
                           Foreground="#1F1F1F"
                           FontFamily="Segoe UI"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Text="{loc:Loc Notification_Completed}"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock x:Name="SummaryText"
                           Grid.Row="2"
                           Grid.Column="2"
                           Margin="0,5,12,12"
                           Foreground="#4A4A4A"
                           FontFamily="Segoe UI"
                           FontSize="12"
                           LineHeight="17"
                           TextWrapping="Wrap"
                           Text="{loc:Loc Notification_DefaultSummary}" />
            </Grid>
        </Border>
    </Grid>
</Window>
