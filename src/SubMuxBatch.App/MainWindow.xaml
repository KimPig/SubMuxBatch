<Window x:Class="SubMuxBatch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:SubMuxBatch.App.ViewModels"
        xmlns:loc="clr-namespace:SubMuxBatch.App.Localization"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="SubMux Batch"
        Width="1080"
        Height="720"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SubtleSurfaceBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDragLeave="Window_PreviewDragLeave"
        PreviewMouseDown="Window_PreviewMouseDown"
        PreviewDrop="Window_Drop">
    <Window.TaskbarItemInfo>
        <shell:TaskbarItemInfo x:Name="TaskbarProgressInfo" />
    </Window.TaskbarItemInfo>
    <Window.Resources>
        <Style x:Key="ToolBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="CompactLogTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border HorizontalAlignment="Left"
                                    Padding="3"
                                    Background="#E9E9E9"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2">
                                <TabPanel x:Name="HeaderPanel"
                                          IsItemsHost="True"
                                          KeyboardNavigation.TabIndex="1"
                                          Panel.ZIndex="1" />
                            </Border>

                            <Border Grid.Row="1"
                                    Margin="0,6,0,0"
                                    Background="White"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CompactLogTabItemStyle" TargetType="TabItem">
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabSurface"
                                MinWidth="{TemplateBinding MinWidth}"
                                MinHeight="{TemplateBinding MinHeight}"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabSurface" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="White" />
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{StaticResource StrongBorderBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TabSurface" Property="Opacity" Value="0.42" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QueueHeaderButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="BorderBrush" Value="#E1E1E1" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HeaderSurface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderSurface" Property="Background" Value="{StaticResource SelectionBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HeaderSurface" Property="Background" Value="{StaticResource SelectionPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="HeaderSurface" Property="Background" Value="{StaticResource SelectionBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QueueColumnResizeThumbStyle" TargetType="{x:Type primitives:Thumb}">
            <Setter Property="Width" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,-5,0" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ToolTip" Value="{loc:Loc Queue_ResizeColumn}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type primitives:Thumb}">
                        <Border x:Name="ResizeSurface"
                                Width="1"
                                HorizontalAlignment="Center"
                                Background="Transparent" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ResizeSurface" Property="Background" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ResizeSurface" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="ResizeSurface" Property="Width" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QueueListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RowSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#E1E1E1"
                                BorderThickness="0,0,0,1"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="SelectionAccent"
                                        Width="3"
                                        HorizontalAlignment="Left"
                                        Background="{StaticResource AccentBrush}"
                                        Visibility="Collapsed" />
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                <Setter TargetName="RowSurface" Property="Background" Value="{StaticResource AlternatingRowBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowSurface" Property="Background" Value="#F2F8FC" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowSurface" Property="Background" Value="{StaticResource SelectionBrush}" />
                                <Setter TargetName="SelectionAccent" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.58" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="2,0,2,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        ToolTip="{loc:Loc Main_Description}">
                <TextBlock Text="SubMux Batch"
                           FontSize="23"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Border Margin="8,1,0,0"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        Background="#E9E9E9"
                        CornerRadius="2">
                    <TextBlock x:Name="VersionText"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Text="v—" />
                </Border>
            </StackPanel>

            <WrapPanel Grid.Column="1"
                       Margin="18,0,8,0"
                       VerticalAlignment="Center">
                <Border Style="{StaticResource ToolBadgeStyle}" ToolTip="{Binding ToolTip, ElementName=MkvStatusText}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="MkvStatusDot" Width="7" Height="7" Fill="#D13438" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="mkvmerge" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="MkvStatusText" Margin="6,0,0,0" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Text="{loc:Loc Common_Checking}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ToolBadgeStyle}" ToolTip="{Binding ToolTip, ElementName=SeConvStatusText}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="SeConvStatusDot" Width="7" Height="7" Fill="#D13438" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="seconv" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="SeConvStatusText" Margin="6,0,0,0" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Text="{loc:Loc Common_Checking}" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <Button x:Name="SettingsButton"
                    Grid.Column="2"
                    Content="{loc:Loc Common_Settings}"
                    Click="SettingsButton_Click"
                    VerticalAlignment="Center"
                    Margin="0" />
        </Grid>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="2"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                MinHeight="180">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="100" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="156" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="#E1E1E1" BorderThickness="0,0,0,1" Padding="9,6">
                    <WrapPanel>
                        <Button x:Name="AddFilesButton" Content="{loc:Loc Main_AddFiles}" Click="AddFilesButton_Click" />
                        <Button x:Name="AddFolderButton" Content="{loc:Loc Main_AddFolder}" Click="AddFolderButton_Click" />
                        <Button x:Name="RemoveButton" Content="{loc:Loc Main_RemoveSelected}" Click="RemoveButton_Click" />
                        <Button x:Name="ClearButton" Content="{loc:Loc Main_ClearAll}" Click="ClearButton_Click" />
                        <TextBlock Margin="10,7,4,5"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="11"
                                   Text="{loc:Loc Main_QueueHelp}" />
                    </WrapPanel>
                </Border>

                <Grid Grid.Row="1"
                      MinHeight="100"
                      Margin="12,6">
                    <Border Background="White"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="2"
                            IsHitTestVisible="False" />

                    <Grid Margin="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border x:Name="QueueHeader"
                                Grid.Row="0"
                                SizeChanged="QueueHeader_SizeChanged"
                                Background="{StaticResource SubtleSurfaceBrush}"
                                BorderBrush="#E1E1E1"
                                BorderThickness="0,0,0,1"
                                CornerRadius="2,2,0,0">
                            <Border.ContextMenu>
                                <ContextMenu Opened="QueueColumnContextMenu_Opened">
                                    <MenuItem Header="{loc:Loc Queue_Name}" Tag="Name" IsCheckable="True" StaysOpenOnClick="True" Click="QueueColumnMenuItem_Click" />
                                    <MenuItem Header="{loc:Loc Queue_Composition}" Tag="DetectedFiles" IsCheckable="True" StaysOpenOnClick="True" Click="QueueColumnMenuItem_Click" />
                                    <MenuItem Header="{loc:Loc Queue_Format}" Tag="MediaFormatText" IsCheckable="True" StaysOpenOnClick="True" Click="QueueColumnMenuItem_Click" />
                                    <MenuItem Header="{loc:Loc Queue_Duration}" Tag="DurationText" IsCheckable="True" StaysOpenOnClick="True" Click="QueueColumnMenuItem_Click" />
                                    <MenuItem Header="{loc:Loc Queue_Codec}" Tag="VideoCodecText" IsCheckable="True" StaysOpenOnClick="True" Click="QueueColumnMenuItem_Click" />
                                    <MenuItem Header="{loc:Loc Queue_Action}" Tag="PlanDescription" IsCheckable="True" StaysOpenOnClick="True" Click="QueueColumnMenuItem_Click" />
                                    <MenuItem Header="{loc:Loc Queue_Status}" Tag="StatusText" IsCheckable="True" StaysOpenOnClick="True" Click="QueueColumnMenuItem_Click" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid x:Name="QueueHeaderGrid"
                                  HorizontalAlignment="Left"
                                  Width="{Binding QueueHeaderContentWidth}"
                                  Margin="{Binding QueueHeaderContentMargin}"
                                  LayoutUpdated="QueueHeaderGrid_LayoutUpdated"
                                  SnapsToDevicePixels="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding FileColumnWidth}" />
                                    <ColumnDefinition Width="{Binding CompositionColumnWidth}" />
                                    <ColumnDefinition Width="{Binding MediaFormatColumnWidth}" />
                                    <ColumnDefinition Width="{Binding DurationColumnWidth}" />
                                    <ColumnDefinition Width="{Binding VideoCodecColumnWidth}" />
                                    <ColumnDefinition Width="{Binding WorkColumnWidth}" />
                                    <ColumnDefinition Width="{Binding StatusColumnWidth}" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Tag="Name" Click="QueueHeader_Click" Style="{StaticResource QueueHeaderButtonStyle}" Visibility="{Binding FileColumnVisibility}">
                                    <Grid>
                                        <TextBlock Text="{loc:Loc Queue_Name}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="NameSortGlyph" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                                    </Grid>
                                </Button>
                                <Button Grid.Column="1" Tag="DetectedFiles" Click="QueueHeader_Click" Style="{StaticResource QueueHeaderButtonStyle}" Visibility="{Binding CompositionColumnVisibility}">
                                    <Grid>
                                        <TextBlock Text="{loc:Loc Queue_Composition}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="DetectedFilesSortGlyph" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                                    </Grid>
                                </Button>
                                <Button Grid.Column="2" Tag="MediaFormatText" Click="QueueHeader_Click" Style="{StaticResource QueueHeaderButtonStyle}" Visibility="{Binding MediaFormatColumnVisibility}">
                                    <Grid>
                                        <TextBlock Text="{loc:Loc Queue_Format}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="MediaFormatSortGlyph" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                                    </Grid>
                                </Button>
                                <Button Grid.Column="3" Tag="DurationText" Click="QueueHeader_Click" Style="{StaticResource QueueHeaderButtonStyle}" Visibility="{Binding DurationColumnVisibility}">
                                    <Grid>
                                        <TextBlock Text="{loc:Loc Queue_Duration}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="DurationSortGlyph" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                                    </Grid>
                                </Button>
                                <Button Grid.Column="4" Tag="VideoCodecText" Click="QueueHeader_Click" Style="{StaticResource QueueHeaderButtonStyle}" Visibility="{Binding VideoCodecColumnVisibility}">
                                    <Grid>
                                        <TextBlock Text="{loc:Loc Queue_Codec}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="VideoCodecSortGlyph" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                                    </Grid>
                                </Button>
                                <Button Grid.Column="5" Tag="PlanDescription" Click="QueueHeader_Click" Style="{StaticResource QueueHeaderButtonStyle}" Visibility="{Binding WorkColumnVisibility}">
                                    <Grid>
                                        <TextBlock Text="{loc:Loc Queue_Action}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="PlanDescriptionSortGlyph" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                                    </Grid>
                                </Button>
                                <Button Grid.Column="6" Tag="StatusText" Click="QueueHeader_Click" Style="{StaticResource QueueHeaderButtonStyle}" BorderThickness="0" Visibility="{Binding StatusColumnVisibility}">
                                    <Grid>
                                        <TextBlock Text="{loc:Loc Queue_Status}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="StatusTextSortGlyph" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                                    </Grid>
                                </Button>
                                <primitives:Thumb Grid.Column="0" Panel.ZIndex="10" Tag="Name"
                                                  Style="{StaticResource QueueColumnResizeThumbStyle}"
                                                  Visibility="{Binding FileColumnResizeVisibility}"
                                                  DragDelta="QueueColumnResizeThumb_DragDelta"
                                                  DragCompleted="QueueColumnResizeThumb_DragCompleted" />
                                <primitives:Thumb Grid.Column="1" Panel.ZIndex="10" Tag="DetectedFiles"
                                                  Style="{StaticResource QueueColumnResizeThumbStyle}"
                                                  Visibility="{Binding CompositionColumnResizeVisibility}"
                                                  DragDelta="QueueColumnResizeThumb_DragDelta"
                                                  DragCompleted="QueueColumnResizeThumb_DragCompleted" />
                                <primitives:Thumb Grid.Column="2" Panel.ZIndex="10" Tag="MediaFormatText"
                                                  Style="{StaticResource QueueColumnResizeThumbStyle}"
                                                  Visibility="{Binding MediaFormatColumnResizeVisibility}"
                                                  DragDelta="QueueColumnResizeThumb_DragDelta"
                                                  DragCompleted="QueueColumnResizeThumb_DragCompleted" />
                                <primitives:Thumb Grid.Column="3" Panel.ZIndex="10" Tag="DurationText"
                                                  Style="{StaticResource QueueColumnResizeThumbStyle}"
                                                  Visibility="{Binding DurationColumnResizeVisibility}"
                                                  DragDelta="QueueColumnResizeThumb_DragDelta"
                                                  DragCompleted="QueueColumnResizeThumb_DragCompleted" />
                                <primitives:Thumb Grid.Column="4" Panel.ZIndex="10" Tag="VideoCodecText"
                                                  Style="{StaticResource QueueColumnResizeThumbStyle}"
                                                  Visibility="{Binding VideoCodecColumnResizeVisibility}"
                                                  DragDelta="QueueColumnResizeThumb_DragDelta"
                                                  DragCompleted="QueueColumnResizeThumb_DragCompleted" />
                                <primitives:Thumb Grid.Column="5" Panel.ZIndex="10" Tag="PlanDescription"
                                                  Style="{StaticResource QueueColumnResizeThumbStyle}"
                                                  Visibility="{Binding WorkColumnResizeVisibility}"
                                                  DragDelta="QueueColumnResizeThumb_DragDelta"
                                                  DragCompleted="QueueColumnResizeThumb_DragCompleted" />
                            </Grid>
                        </Border>

                        <Grid x:Name="QueueListSurface" Grid.Row="1">
                            <ListBox x:Name="JobsList"
                                     ItemsSource="{Binding QueueRows}"
                                     AlternationCount="2"
                                     AllowDrop="True"
                                     SelectionMode="Extended"
                                     SelectionChanged="JobsList_SelectionChanged"
                                     PreviewMouseLeftButtonDown="JobsList_PreviewMouseLeftButtonDown"
                                     PreviewMouseLeftButtonUp="JobsList_PreviewMouseLeftButtonUp"
                                     PreviewMouseWheel="JobsList_PreviewMouseWheel"
                                     PreviewKeyDown="JobsList_PreviewKeyDown"
                                     PreviewMouseMove="JobsList_PreviewMouseMove"
                                     PreviewDragOver="JobsList_PreviewDragOver"
                                     PreviewDragLeave="JobsList_PreviewDragLeave"
                                     Drop="JobsList_Drop"
                                     LayoutUpdated="JobsList_LayoutUpdated"
                                     ItemContainerStyle="{StaticResource QueueListItemStyle}"
                                     BorderThickness="0"
                                     Padding="0"
                                     Background="White"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Visible"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.Resources>
                                    <DataTemplate DataType="{x:Type viewModels:QueueItemViewModel}">
                                        <Grid MinHeight="48"
                                              Margin="{Binding DataContext.QueueRowContentMargin, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                              SnapsToDevicePixels="True"
                                              ToolTipService.ShowDuration="12000">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding DataContext.QueueRowFileColumnWidth, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                <ColumnDefinition Width="{Binding DataContext.QueueRowCompositionColumnWidth, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                <ColumnDefinition Width="{Binding DataContext.QueueRowMediaFormatColumnWidth, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                <ColumnDefinition Width="{Binding DataContext.QueueRowDurationColumnWidth, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                <ColumnDefinition Width="{Binding DataContext.QueueRowVideoCodecColumnWidth, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                <ColumnDefinition Width="{Binding DataContext.QueueRowWorkColumnWidth, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                <ColumnDefinition Width="{Binding DataContext.QueueRowStatusColumnWidth, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" BorderBrush="#E8E8E8" BorderThickness="0,0,1,0"
                                                    Visibility="{Binding DataContext.FileColumnVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                                                <StackPanel Margin="12,5" ToolTip="{Binding Folder}">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Folder}" Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" BorderBrush="#E8E8E8" BorderThickness="0,0,1,0"
                                                    Visibility="{Binding DataContext.CompositionColumnVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                                                <TextBlock Margin="12,5"
                                                           Text="{Binding DetectedFiles}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <Border Grid.Column="2"
                                                    BorderBrush="#E8E8E8"
                                                    BorderThickness="0,0,1,0"
                                                    ToolTip="{Binding InputSummary}"
                                                    Visibility="{Binding DataContext.MediaFormatColumnVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                                                <TextBlock Margin="12,5" Text="{Binding MediaFormatText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <Border Grid.Column="3"
                                                    BorderBrush="#E8E8E8"
                                                    BorderThickness="0,0,1,0"
                                                    ToolTip="{Binding InputSummary}"
                                                    Visibility="{Binding DataContext.DurationColumnVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                                                <TextBlock Margin="12,5" Text="{Binding DurationText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <Border Grid.Column="4"
                                                    BorderBrush="#E8E8E8"
                                                    BorderThickness="0,0,1,0"
                                                    ToolTip="{Binding VideoSummary}"
                                                    Visibility="{Binding DataContext.VideoCodecColumnVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                                                <TextBlock Margin="12,5" Text="{Binding VideoCodecText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <Border Grid.Column="5" BorderBrush="#E8E8E8" BorderThickness="0,0,1,0"
                                                    Visibility="{Binding DataContext.WorkColumnVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                                                <StackPanel Margin="12,5" ToolTip="{Binding OutputFile}">
                                                    <TextBlock Text="{Binding PlanDescription}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding OutputFile}" Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="6"
                                                    Padding="12,5"
                                                    Background="{Binding StatusBackground}"
                                                    Visibility="{Binding DataContext.StatusColumnVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}"
                                                               Foreground="{Binding StatusForeground}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <ProgressBar Height="4"
                                                                 Margin="0,4,0,0"
                                                                 Minimum="0"
                                                                 Maximum="100"
                                                                 Value="{Binding Progress}"
                                                                 Foreground="{Binding StatusForeground}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:QueueEndSpacerViewModel}">
                                        <Grid Height="48"
                                              Margin="{Binding DataContext.QueueRowContentMargin, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                              Background="White"
                                              SnapsToDevicePixels="True"
                                              IsHitTestVisible="False">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding DataContext.QueueRowFileColumnWidth, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                <ColumnDefinition Width="{Binding DataContext.QueueRowCompositionColumnWidth, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                <ColumnDefinition Width="{Binding DataContext.QueueRowMediaFormatColumnWidth, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                <ColumnDefinition Width="{Binding DataContext.QueueRowDurationColumnWidth, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                <ColumnDefinition Width="{Binding DataContext.QueueRowVideoCodecColumnWidth, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                <ColumnDefinition Width="{Binding DataContext.QueueRowWorkColumnWidth, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                <ColumnDefinition Width="{Binding DataContext.QueueRowStatusColumnWidth, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" BorderBrush="#E8E8E8" BorderThickness="0,0,1,0" />
                                            <Border Grid.Column="1" BorderBrush="#E8E8E8" BorderThickness="0,0,1,0" />
                                            <Border Grid.Column="2" BorderBrush="#E8E8E8" BorderThickness="0,0,1,0" />
                                            <Border Grid.Column="3" BorderBrush="#E8E8E8" BorderThickness="0,0,1,0" />
                                            <Border Grid.Column="4" BorderBrush="#E8E8E8" BorderThickness="0,0,1,0" />
                                            <Border Grid.Column="5" BorderBrush="#E8E8E8" BorderThickness="0,0,1,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.Resources>
                            </ListBox>

                            <Border x:Name="EmptyDropPanel"
                                    Background="{StaticResource AlternatingRowBrush}"
                                    CornerRadius="0,0,2,2"
                                    BorderBrush="{StaticResource StrongBorderBrush}"
                                    BorderThickness="1"
                                    IsHitTestVisible="False">
                                <TextBlock Margin="12,6"
                                           Text="{loc:Loc Main_DropPrompt}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis" />
                            </Border>

                            <Border x:Name="DragOverlay" Visibility="Collapsed" Background="{StaticResource AccentBrush}" Opacity="0.92" CornerRadius="0,0,2,2" IsHitTestVisible="False">
                                <Viewbox Margin="10"
                                         Stretch="Uniform"
                                         StretchDirection="DownOnly"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center">
                                    <StackPanel Width="480">
                                        <TextBlock Text="{loc:Loc Main_DropToAdd}" Foreground="White" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock Text="{loc:Loc Main_DropDescription}"
                                                   Foreground="#E5F3FF"
                                                   Margin="0,7,0,0"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Viewbox>
                            </Border>

                            <Border x:Name="QueueDropIndicator"
                                    Height="3"
                                    Margin="12,0,30,0"
                                    VerticalAlignment="Top"
                                    Background="{StaticResource AccentBrush}"
                                    CornerRadius="2"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False"
                                    Panel.ZIndex="10">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="QueueDropIndicatorTransform" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <Border Grid.Row="2"
                        Background="#E1E1E1"
                        IsHitTestVisible="False" />

                <Border x:Name="SelectedItemPanel"
                        Grid.Row="3"
                        Background="{StaticResource AlternatingRowBrush}">
                    <Grid>
                        <TextBlock Text="{loc:Loc Main_SelectItemPrompt}"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="18">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem, ElementName=JobsList}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Grid DataContext="{Binding SelectedItem, ElementName=JobsList}">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Padding="12,6"
                                    Background="White"
                                    BorderBrush="#E1E1E1"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name, Mode=OneWay}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               ToolTip="{Binding Name}"
                                               TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="1"
                                            Margin="12,-2,0,-2"
                                            Padding="9,2"
                                            Content="{loc:Loc Main_MediaInfo}"
                                            Click="OpenSelectedMediaInfoButton_Click" />
                                    <Button Grid.Column="2"
                                            Margin="8,-2,0,-2"
                                            Padding="9,2"
                                            Content="{loc:Loc Main_ViewJobLog}"
                                            Click="OpenSelectedJobLogButton_Click" />
                                    <TextBlock Grid.Column="3"
                                               Margin="12,0,0,0"
                                               Text="{Binding StatusText}"
                                               Foreground="{Binding StatusForeground}"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold" />
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1"
                                  Margin="12,7,8,8">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="1" />
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{loc:Loc Detail_Input}" Foreground="{StaticResource SecondaryTextBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding InputSummary}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="1" Margin="0,3,0,0" Text="{loc:Loc Detail_Video}" Foreground="{StaticResource SecondaryTextBrush}" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,3,0,0" Text="{Binding VideoSummary}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="2" Margin="0,3,0,0" Text="{loc:Loc Detail_Audio}" Foreground="{StaticResource SecondaryTextBrush}" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,3,0,0" Text="{Binding AudioSummary}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="3" Margin="0,3,0,0" Text="{loc:Loc Detail_Composition}" Foreground="{StaticResource SecondaryTextBrush}" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,3,0,0" Text="{Binding TrackSummary}" TextWrapping="Wrap" />
                                        </Grid>

                                        <Border Grid.Column="2" Background="#E1E1E1" />

                                        <Grid Grid.Column="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{loc:Loc Detail_VideoFile}" Foreground="{StaticResource SecondaryTextBrush}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding VideoFileNamesDisplay}"
                                                       ToolTip="{Binding VideoPathDisplay}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="1" Margin="0,3,0,0"
                                                       Text="{loc:Loc Detail_ExternalSubtitles}"
                                                       Foreground="{StaticResource SecondaryTextBrush}" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,3,0,0"
                                                       Text="{Binding SubtitlePathsDisplay}"
                                                       ToolTip="{Binding SubtitlePathDisplay}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="2" Margin="0,3,0,0"
                                                       Text="{loc:Loc Detail_Action}"
                                                       Foreground="{StaticResource SecondaryTextBrush}" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,3,0,0"
                                                       Text="{Binding PlanDescription}"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </Grid>
                                    <TextBlock Margin="0,5,0,0"
                                               Text="{Binding IssuesText}"
                                               ToolTip="{Binding IssuesText}"
                                               Foreground="{Binding StatusForeground}"
                                               FontSize="11"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IssuesText}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="2,8,2,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="OverallStatusText"
                           Text="{loc:Loc Main_AddFilesPrompt}"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           AutomationProperties.LiveSetting="Polite"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           Foreground="#767676"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Margin="12,0,10,0"
                           Text="{loc:Loc Main_OriginalFilesNotice}" />
            </Grid>
            <ProgressBar Grid.Row="1"
                         Grid.Column="0"
                         x:Name="OverallProgressBar"
                         Height="6"
                         Margin="0,0,12,0"
                         Minimum="0"
                         Maximum="100"
                         Value="0" />
            <StackPanel Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal">
                <Button Content="{loc:Loc Common_ViewLog}" Click="OpenLogWindowButton_Click" />
                <Button x:Name="CancelButton" Content="{loc:Loc Common_Cancel}" Click="CancelButton_Click" IsEnabled="False" />
                <Button x:Name="StartButton"
                        Content="{loc:Loc Main_StartAllReady}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="StartButton_Click"
                        Margin="0"
                        IsEnabled="False" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
