<Window x:Class="SubMuxBatch.App.ManualAssStyleInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Style 수동 입력"
        Width="620"
        Height="300"
        MinWidth="480"
        MinHeight="260"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#F3F3F3"
        Foreground="#201F1E"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary Source="Win10DialogStyles.xaml" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Margin="18"
                Padding="18"
                Background="White"
                BorderBrush="#D1D1D1"
                BorderThickness="1"
                CornerRadius="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                           TextWrapping="Wrap"
                           Text="ASS v4+ Style 한 줄을 붙여넣으세요. 'Style: Default,...'와 'Default,...' 형식을 모두 사용할 수 있습니다." />
                <TextBox Grid.Row="1"
                         x:Name="StyleTextBox"
                         Margin="0,14,0,0"
                         Style="{StaticResource FluentTextBoxStyle}"
                         Padding="10,8"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Padding="18,14"
                Background="White"
                BorderBrush="#D1D1D1"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="취소" IsCancel="True" />
                <Button Content="적용"
                        Margin="0"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="ApplyButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
