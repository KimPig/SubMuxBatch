<Window x:Class="SubMuxBatch.App.UpdateStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#F3F3F3"
        Foreground="#201F1E"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary Source="Win10DialogStyles.xaml" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Margin="18"
                Padding="18"
                Background="White"
                BorderBrush="#D1D1D1"
                BorderThickness="1"
                CornerRadius="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="AccentBar"
                        Background="{StaticResource AccentBrush}"
                        CornerRadius="2" />
                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                    <TextBlock x:Name="HeadingText"
                               FontSize="18"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="DescriptionText"
                               Margin="0,8,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailsText"
                               Margin="0,12,0,0"
                               Padding="10,8"
                               Background="#F7F7F7"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Padding="18,14"
                Background="White"
                BorderBrush="#D1D1D1"
                BorderThickness="0,1,0,0">
            <Button x:Name="CloseButton"
                    HorizontalAlignment="Right"
                    Margin="0"
                    MinWidth="86"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="CloseButton_Click" />
        </Border>
    </Grid>
</Window>
