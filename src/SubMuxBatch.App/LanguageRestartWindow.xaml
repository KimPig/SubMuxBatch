<Window x:Class="SubMuxBatch.App.LanguageRestartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SubMuxBatch.App.Localization"
        Title="{loc:Loc LanguageRestart_Title}"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#F3F3F3"
        Foreground="#201F1E"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary Source="Win10DialogStyles.xaml" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Margin="18"
                Padding="18"
                Background="White"
                BorderBrush="#D1D1D1"
                BorderThickness="1"
                CornerRadius="2">
            <StackPanel>
                <TextBlock Text="{loc:Loc LanguageRestart_Heading}"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,8,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="{loc:Loc LanguageRestart_Description}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Padding="18,14"
                Background="White"
                BorderBrush="#D1D1D1"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:Loc LanguageRestart_Later}"
                        IsCancel="True" />
                <Button Content="{loc:Loc LanguageRestart_Restart}"
                        Margin="0"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="RestartButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
