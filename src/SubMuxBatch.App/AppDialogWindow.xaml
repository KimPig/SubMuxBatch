<Window x:Class="SubMuxBatch.App.AppDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460"
        SizeToContent="Height"
        MinWidth="380"
        MaxWidth="620"
        MaxHeight="650"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#F3F3F3"
        Foreground="#201F1E"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Win10DialogStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Padding="22" Background="White">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="IconBorder"
                        Width="36"
                        Height="36"
                        Margin="0,1,16,0"
                        VerticalAlignment="Top"
                        CornerRadius="18">
                    <TextBlock x:Name="IconText"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Foreground="White" />
                </Border>
                <ScrollViewer Grid.Column="1"
                              MaxHeight="430"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="MessageText"
                               Margin="0,7,4,4"
                               FontSize="13"
                               LineHeight="20"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Padding="14,12"
                Background="#F3F3F3"
                BorderBrush="#D1D1D1"
                BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="PrimaryButton"
                        MinWidth="86"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True"
                        Click="PrimaryButton_Click" />
                <Button x:Name="SecondaryButton"
                        MinWidth="86"
                        Margin="0,0,8,0"
                        Click="SecondaryButton_Click" />
                <Button x:Name="TertiaryButton"
                        MinWidth="86"
                        Margin="0"
                        Visibility="Collapsed"
                        Click="TertiaryButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
