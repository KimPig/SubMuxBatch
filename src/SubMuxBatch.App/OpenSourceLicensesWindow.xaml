<Window x:Class="SubMuxBatch.App.OpenSourceLicensesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SubMuxBatch.App.Localization"
        Title="{loc:Loc Licenses_Title}"
        Width="820"
        Height="600"
        MinWidth="620"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#F3F3F3"
        Foreground="#201F1E"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Win10DialogStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="White"
                BorderBrush="#D1D1D1"
                BorderThickness="0,0,0,1"
                Padding="22,18">
            <StackPanel>
                <TextBlock Text="{loc:Loc Licenses_Title}"
                           FontSize="24"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextWrapping="Wrap"
                           Text="{loc:Loc Licenses_Description}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="ComponentList"
                     DisplayMemberPath="Title"
                     SelectionChanged="ComponentList_SelectionChanged" />

            <TextBox x:Name="LicenseTextBox"
                     Grid.Column="2"
                     Padding="12"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="NoWrap"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="12" />
        </Grid>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#D1D1D1"
                BorderThickness="0,1,0,0"
                Padding="18,14">
            <Grid>
                <Button x:Name="ProjectPageButton"
                        HorizontalAlignment="Left"
                        Content="{loc:Loc Licenses_ProjectPage}"
                        Click="ProjectPage_Click" />
                <Button HorizontalAlignment="Right"
                        IsCancel="True"
                        Content="{loc:Loc Common_Close}" />
            </Grid>
        </Border>
    </Grid>
</Window>
