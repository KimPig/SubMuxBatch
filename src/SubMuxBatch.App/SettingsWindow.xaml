<Window x:Class="SubMuxBatch.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SubMux Batch 설정"
        Width="720"
        Height="680"
        MinWidth="540"
        MinHeight="460"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#F3F3F3"
        Foreground="#201F1E"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Win10DialogStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D1D1D1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,14,10" />
        </Style>
        <Style x:Key="FieldTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource FluentTextBoxStyle}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="SettingsComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Foreground" Value="#201F1E" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemSurface"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#E5F1FB" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#CCE4F7" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="#8A8886" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsComboBoxItemStyle}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="InputSurface"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2" />
                            <ToggleButton x:Name="DropDownToggle"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Grid Margin="11,0,10,0" IsHitTestVisible="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                                <Path Grid.Column="1"
                                      Width="9"
                                      Height="5"
                                      Margin="12,0,1,0"
                                      VerticalAlignment="Center"
                                      Data="M 0 0 L 4.5 4.5 L 9 0"
                                      Stroke="#605E5C"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Grid>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=DropDownToggle}"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, ElementName=DropDownToggle}"
                                        Margin="0,1,0,0"
                                        Padding="1"
                                        Background="White"
                                        BorderBrush="#8A8886"
                                        BorderThickness="1"
                                        CornerRadius="2">
                                    <ScrollViewer MaxHeight="220" CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputSurface" Property="BorderBrush" Value="#323130" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="InputSurface" Property="BorderThickness" Value="1" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="InputSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Background="White"
                                    BorderBrush="#D1D1D1"
                                    BorderThickness="0,0,0,1">
                                <TabPanel x:Name="HeaderPanel"
                                          IsItemsHost="True"
                                          KeyboardNavigation.TabIndex="1"
                                          Panel.ZIndex="1" />
                            </Border>

                            <Border Grid.Row="1"
                                    Padding="14,0"
                                    Background="#F3F3F3">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#605E5C" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabSurface"
                                MinWidth="{TemplateBinding MinWidth}"
                                MinHeight="{TemplateBinding MinHeight}"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabSurface" Property="Background" Value="#F3F2F1" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="White" />
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TabSurface" Property="Opacity" Value="0.42" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#D1D1D1" BorderThickness="0,0,0,1" Padding="22,18">
            <StackPanel>
                <TextBlock Text="설정" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextWrapping="Wrap"
                           Text="파일 매칭, MKV 출력 방식과 SRT→ASS 기본 스타일을 조정합니다." />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="18,12,18,0">
            <TabItem Header="일반">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,12,4,0">
                    <StackPanel>
                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock Text="파일 탐색과 매칭" FontSize="18" FontWeight="SemiBold" />
                                <CheckBox x:Name="IncludeSubdirectoriesCheckBox"
                                          Margin="0,16,0,0">
                                    <TextBlock Text="폴더 추가 시 하위 폴더도 탐색" TextWrapping="Wrap" />
                                </CheckBox>
                                <CheckBox x:Name="AllowSubtitleSuffixMatchCheckBox"
                                          Margin="0,12,0,0">
                                    <TextBlock Text="자막 파일명의 점 접미사 허용" TextWrapping="Wrap" />
                                </CheckBox>
                                <TextBlock Margin="24,5,0,0"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="켜면 Movie.mp4에 Movie.kor.srt, Movie.ko.ass처럼 점 뒤에 태그가 붙은 자막도 연결합니다. 정확히 같은 이름의 자막이 항상 우선합니다." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock Text="작업 실행" FontSize="18" FontWeight="SemiBold" />
                                <Grid Margin="0,14,0,0"
                                      MaxWidth="360"
                                      HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="190" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="동시 작업 수"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,14,0" />
                                    <ComboBox Grid.Column="1"
                                              x:Name="ConcurrentJobCountComboBox"
                                              Style="{StaticResource SettingsComboBoxStyle}"
                                              SelectedValuePath="Tag">
                                        <ComboBoxItem Content="1개" Tag="1" />
                                        <ComboBoxItem Content="2개" Tag="2" />
                                        <ComboBoxItem Content="3개" Tag="3" />
                                        <ComboBoxItem Content="4개" Tag="4" />
                                        <ComboBoxItem Content="5개" Tag="5" />
                                        <ComboBoxItem Content="6개" Tag="6" />
                                        <ComboBoxItem Content="7개" Tag="7" />
                                        <ComboBoxItem Content="8개" Tag="8" />
                                    </ComboBox>
                                </Grid>
                                <TextBlock Margin="0,8,0,0"
                                           MaxWidth="520"
                                           HorizontalAlignment="Left"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="동시에 실행할 자막 변환·MKV 병합 작업 수입니다. 같은 드라이브에서는 1개를 권장합니다." />
                                <CheckBox x:Name="ShowCompletionNotificationCheckBox"
                                          Margin="0,16,0,0">
                                    <TextBlock Text="배치 작업이 끝나면 알림 표시"
                                               TextWrapping="Wrap" />
                                </CheckBox>
                                <TextBlock Margin="24,5,0,0"
                                           MaxWidth="520"
                                           HorizontalAlignment="Left"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="프로그램이 있는 모니터 오른쪽 아래에 완료 결과 카드를 표시합니다." />
                                <CheckBox x:Name="PlayCompletionSoundCheckBox"
                                          Margin="0,14,0,0">
                                    <TextBlock Text="배치 작업이 끝나면 시스템 알림음 재생"
                                               TextWrapping="Wrap" />
                                </CheckBox>
                                <TextBlock Margin="24,5,0,0"
                                           MaxWidth="520"
                                           HorizontalAlignment="Left"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="사용자가 취소한 작업에는 알림과 소리를 사용하지 않습니다." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock Text="MKV 출력" FontSize="18" FontWeight="SemiBold" />
                                <Grid Margin="0,14,0,0"
                                      MaxWidth="520"
                                      HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="출력 파일 접두사"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,14,0" />
                                    <TextBox Grid.Column="1"
                                             x:Name="OutputPrefixTextBox"
                                             Style="{StaticResource FieldTextBoxStyle}"
                                             MinWidth="180"
                                             Margin="0" />
                                </Grid>
                                <CheckBox x:Name="RemoveExistingSubtitlesCheckBox"
                                          Margin="0,16,0,0">
                                    <TextBlock Text="원본 영상의 내장 자막을 모두 제거" TextWrapping="Wrap" />
                                </CheckBox>
                                <TextBlock Margin="24,5,0,0"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="해제하면 기존 자막 형식과 트랙은 그대로 보존하고, 새 ASS와 SRT를 마지막에 추가합니다. 새 ASS가 기본 자막이 되도록 기존 자막의 기본 플래그만 해제합니다." />
                                <CheckBox x:Name="RemoveExistingFontAttachmentsCheckBox"
                                          Margin="0,14,0,0">
                                    <TextBlock Text="원본 영상에 첨부된 폰트 파일 제거" TextWrapping="Wrap" />
                                </CheckBox>
                                <TextBlock Margin="24,5,0,0"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="켜면 원본 영상의 첨부파일 중 폰트만 제거합니다. 폰트가 아닌 다른 첨부파일은 보존합니다." />
                                <CheckBox x:Name="FilterAudioTracksByLanguageCheckBox"
                                          Margin="0,14,0,0">
                                    <TextBlock Text="선택한 언어의 오디오 트랙만 유지"
                                               TextWrapping="Wrap" />
                                </CheckBox>
                                <TextBlock Margin="24,5,0,0"
                                           MaxWidth="360"
                                           HorizontalAlignment="Left"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="여러 오디오 트랙이 있을 때 선택한 언어만 결과 MKV에 포함합니다." />
                                <Grid Margin="24,10,0,0"
                                      MaxWidth="360"
                                      HorizontalAlignment="Left"
                                      IsEnabled="{Binding IsChecked, ElementName=FilterAudioTracksByLanguageCheckBox}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="190" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="유지할 언어"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,14,0" />
                                    <ComboBox Grid.Column="1"
                                              x:Name="AudioLanguageComboBox"
                                              Style="{StaticResource SettingsComboBoxStyle}"
                                              SelectedValuePath="Tag"
                                              VerticalAlignment="Center">
                                        <ComboBoxItem Content="영어" Tag="English" />
                                        <ComboBoxItem Content="일본어" Tag="Japanese" />
                                        <ComboBoxItem Content="한국어" Tag="Korean" />
                                    </ComboBox>
                                </Grid>
                                <TextBlock Margin="24,7,0,0"
                                           MaxWidth="360"
                                           HorizontalAlignment="Left"
                                           Foreground="#9A5B13"
                                           FontSize="11"
                                           TextWrapping="NoWrap"
                                           Text="선택한 언어 트랙이 없으면 해당 작업은 건너뜁니다."
                                           IsEnabled="{Binding IsChecked, ElementName=FilterAudioTracksByLanguageCheckBox}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="ASS 스타일">
                <Border Style="{StaticResource SectionCardStyle}"
                        Margin="0,14"
                        VerticalAlignment="Top">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <CheckBox x:Name="UseCustomAssStyleCheckBox"
                                  VerticalAlignment="Center"
                                  Content="SRT → ASS 변환 시 지정한 스타일 사용" />
                        <Button Grid.Column="1"
                                Content="더보기"
                                Margin="14,0,0,0"
                                Click="OpenAssStyleDetails_Click" />
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="외부 도구">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,12,4,0">
                    <StackPanel>
                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock Text="MKVToolNix" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Margin="0,4,0,10" Foreground="{StaticResource SecondaryTextBrush}" Text="mkvmerge.exe" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="MkvMergePathTextBox" Style="{StaticResource FieldTextBoxStyle}" Margin="0" />
                                    <Button Grid.Column="1" Content="찾기" Margin="8,0,0,0" Click="BrowseMkvMerge_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Subtitle Edit seconv" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Margin="0,4,0,10"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="기본 Subtitle Edit 설치본에는 포함되지 않으므로 SeConv-Windows-x64.zip을 별도로 풀어 지정해야 합니다." />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SeConvPathTextBox" Style="{StaticResource FieldTextBoxStyle}" Margin="0" />
                                    <Button Grid.Column="1" Content="찾기" Margin="8,0,0,0" Click="BrowseSeConv_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="4,0,4,12"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="비워 두면 앱 옆 tools 폴더, PATH, 표준 설치 경로 순으로 자동 탐색합니다." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="White" BorderBrush="#D1D1D1" BorderThickness="0,1,0,0" Padding="18,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="취소" IsCancel="True" />
                <Button Content="저장" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Click="SaveButton_Click" Margin="0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
