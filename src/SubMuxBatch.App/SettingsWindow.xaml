<Window x:Class="SubMuxBatch.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SubMuxBatch.App.Localization"
        Title="{loc:Loc Settings_Title}"
        Width="720"
        Height="680"
        MinWidth="540"
        MinHeight="460"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#F3F3F3"
        Foreground="#201F1E"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Win10DialogStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D1D1D1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,14,10" />
        </Style>
        <Style x:Key="FieldTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource FluentTextBoxStyle}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="AssFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="AssFieldTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource FieldTextBoxStyle}">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="AssFieldContainerStyle" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="SettingsComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Foreground" Value="#201F1E" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemSurface"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#E5F1FB" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#CCE4F7" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="#8A8886" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsComboBoxItemStyle}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="InputSurface"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2" />
                            <ToggleButton x:Name="DropDownToggle"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Grid Margin="11,0,10,0" IsHitTestVisible="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                                <Path Grid.Column="1"
                                      Width="9"
                                      Height="5"
                                      Margin="12,0,1,0"
                                      VerticalAlignment="Center"
                                      Data="M 0 0 L 4.5 4.5 L 9 0"
                                      Stroke="#605E5C"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Grid>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=DropDownToggle}"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, ElementName=DropDownToggle}"
                                        Margin="0,1,0,0"
                                        Padding="1"
                                        Background="White"
                                        BorderBrush="#8A8886"
                                        BorderThickness="1"
                                        CornerRadius="2">
                                    <ScrollViewer MaxHeight="220" CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputSurface" Property="BorderBrush" Value="#323130" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="InputSurface" Property="BorderThickness" Value="1" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="InputSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AssFieldComboBoxStyle"
               TargetType="ComboBox"
               BasedOn="{StaticResource SettingsComboBoxStyle}">
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Background="White"
                                    BorderBrush="#D1D1D1"
                                    BorderThickness="0,0,0,1">
                                <TabPanel x:Name="HeaderPanel"
                                          IsItemsHost="True"
                                          KeyboardNavigation.TabIndex="1"
                                          Panel.ZIndex="1" />
                            </Border>

                            <Border Grid.Row="1"
                                    Padding="14,0"
                                    Background="#F3F3F3">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#605E5C" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabSurface"
                                MinWidth="{TemplateBinding MinWidth}"
                                MinHeight="{TemplateBinding MinHeight}"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabSurface" Property="Background" Value="#F3F2F1" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="White" />
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TabSurface" Property="Opacity" Value="0.42" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#D1D1D1" BorderThickness="0,0,0,1" Padding="22,18">
            <StackPanel>
                <TextBlock Text="{loc:Loc Common_Settings}" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextWrapping="Wrap"
                           Text="{loc:Loc Settings_Description}" />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="18,12,18,0">
            <TabItem Header="{loc:Loc Settings_TabGeneral}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,12,4,0">
                    <StackPanel>
                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Settings_Interface}" FontSize="18" FontWeight="SemiBold" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Loc Settings_Language}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,14,0" />
                                    <ComboBox Grid.Column="1"
                                              x:Name="LanguageComboBox"
                                              Style="{StaticResource SettingsComboBoxStyle}"
                                              SelectedValuePath="Tag">
                                        <ComboBoxItem Content="{loc:Loc Settings_LanguageSystem}" Tag="System" />
                                        <ComboBoxItem Content="한국어" Tag="Korean" />
                                        <ComboBoxItem Content="English" Tag="English" />
                                    </ComboBox>
                                </Grid>
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Text="{loc:Loc Settings_LanguageHelp}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Settings_FileDiscovery}" FontSize="18" FontWeight="SemiBold" />
                                <CheckBox x:Name="IncludeSubdirectoriesCheckBox"
                                          Margin="0,16,0,0">
                                    <TextBlock Text="{loc:Loc Settings_IncludeSubfolders}" TextWrapping="Wrap" />
                                </CheckBox>
                                <CheckBox x:Name="AllowSubtitleSuffixMatchCheckBox"
                                          Margin="0,12,0,0">
                                    <TextBlock Text="{loc:Loc Settings_AllowSubtitleSuffix}" TextWrapping="Wrap" />
                                </CheckBox>
                                <TextBlock Margin="24,5,0,0"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="{loc:Loc Settings_AllowSubtitleSuffixHelp}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Settings_Execution}" FontSize="18" FontWeight="SemiBold" />
                                <Grid Margin="0,14,0,0"
                                      MaxWidth="360"
                                      HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="190" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Loc Settings_ConcurrentJobs}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,14,0" />
                                    <ComboBox Grid.Column="1"
                                              x:Name="ConcurrentJobCountComboBox"
                                              Style="{StaticResource SettingsComboBoxStyle}"
                                              SelectedValuePath="Tag">
                                        <ComboBoxItem Content="1" Tag="1" />
                                        <ComboBoxItem Content="2" Tag="2" />
                                        <ComboBoxItem Content="3" Tag="3" />
                                        <ComboBoxItem Content="4" Tag="4" />
                                        <ComboBoxItem Content="5" Tag="5" />
                                        <ComboBoxItem Content="6" Tag="6" />
                                        <ComboBoxItem Content="7" Tag="7" />
                                        <ComboBoxItem Content="8" Tag="8" />
                                    </ComboBox>
                                </Grid>
                                <TextBlock Margin="0,8,0,0"
                                           MaxWidth="520"
                                           HorizontalAlignment="Left"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="{loc:Loc Settings_ConcurrentJobsHelp}" />
                                <CheckBox x:Name="ShowCompletionNotificationCheckBox"
                                          Margin="0,16,0,0">
                                    <TextBlock Text="{loc:Loc Settings_ShowNotification}"
                                               TextWrapping="Wrap" />
                                </CheckBox>
                                <TextBlock Margin="24,5,0,0"
                                           MaxWidth="520"
                                           HorizontalAlignment="Left"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="{loc:Loc Settings_ShowNotificationHelp}" />
                                <CheckBox x:Name="PlayCompletionSoundCheckBox"
                                          Margin="0,14,0,0">
                                    <TextBlock Text="{loc:Loc Settings_PlaySound}"
                                               TextWrapping="Wrap" />
                                </CheckBox>
                                <TextBlock Margin="24,5,0,0"
                                           MaxWidth="520"
                                           HorizontalAlignment="Left"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="{loc:Loc Settings_PlaySoundHelp}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Settings_MkvOutput}" FontSize="18" FontWeight="SemiBold" />
                                <Grid Margin="0,14,0,0"
                                      MaxWidth="520"
                                      HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Loc Settings_OutputPrefix}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,14,0" />
                                    <TextBox Grid.Column="1"
                                             x:Name="OutputPrefixTextBox"
                                             Style="{StaticResource FieldTextBoxStyle}"
                                             MinWidth="180"
                                             Margin="0" />
                                </Grid>
                                <CheckBox x:Name="AddSubMuxTagCheckBox"
                                          Margin="0,16,0,0">
                                    <TextBlock Text="{loc:Loc Settings_AddSubMuxTag}" TextWrapping="Wrap" />
                                </CheckBox>
                                <TextBlock Margin="24,5,0,0"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="{loc:Loc Settings_AddSubMuxTagHelp}" />
                                <CheckBox x:Name="RemoveExistingSubtitlesCheckBox"
                                          Margin="0,14,0,0">
                                    <TextBlock Text="{loc:Loc Settings_RemoveSubtitles}" TextWrapping="Wrap" />
                                </CheckBox>
                                <TextBlock Margin="24,5,0,0"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="{loc:Loc Settings_RemoveSubtitlesHelp}" />
                                <CheckBox x:Name="RemoveChaptersCheckBox"
                                          Margin="0,14,0,0">
                                    <TextBlock Text="{loc:Loc Settings_RemoveChapters}" TextWrapping="Wrap" />
                                </CheckBox>
                                <TextBlock Margin="24,5,0,0"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="{loc:Loc Settings_RemoveChaptersHelp}" />
                                <CheckBox x:Name="RemoveExistingFontAttachmentsCheckBox"
                                          Margin="0,14,0,0">
                                    <TextBlock Text="{loc:Loc Settings_RemoveFonts}" TextWrapping="Wrap" />
                                </CheckBox>
                                <TextBlock Margin="24,5,0,0"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="{loc:Loc Settings_RemoveFontsHelp}" />
                                <CheckBox x:Name="AttachAssStyleFontsCheckBox"
                                          Margin="0,14,0,0">
                                    <TextBlock Text="{loc:Loc Settings_AttachFonts}" TextWrapping="Wrap" />
                                </CheckBox>
                                <TextBlock Margin="24,5,0,0"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="{loc:Loc Settings_AttachFontsHelp}" />
                                <TextBlock Margin="24,5,0,0"
                                           Foreground="#9A5B13"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Text="{loc:Loc Settings_FontLicense}" />
                                <CheckBox x:Name="FilterAudioTracksByLanguageCheckBox"
                                          Margin="0,14,0,0">
                                    <TextBlock Text="{loc:Loc Settings_FilterAudio}"
                                               TextWrapping="Wrap" />
                                </CheckBox>
                                <TextBlock Margin="24,5,0,0"
                                           MaxWidth="360"
                                           HorizontalAlignment="Left"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="{loc:Loc Settings_FilterAudioHelp}" />
                                <Grid Margin="24,10,0,0"
                                      MaxWidth="360"
                                      HorizontalAlignment="Left"
                                      IsEnabled="{Binding IsChecked, ElementName=FilterAudioTracksByLanguageCheckBox}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="190" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Loc Settings_AudioLanguage}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,14,0" />
                                    <ComboBox Grid.Column="1"
                                              x:Name="AudioLanguageComboBox"
                                              Style="{StaticResource SettingsComboBoxStyle}"
                                              SelectedValuePath="Tag"
                                              VerticalAlignment="Center">
                                        <ComboBoxItem Content="{loc:Loc Language_English}" Tag="English" />
                                        <ComboBoxItem Content="{loc:Loc Language_Japanese}" Tag="Japanese" />
                                        <ComboBoxItem Content="{loc:Loc Language_Korean}" Tag="Korean" />
                                    </ComboBox>
                                </Grid>
                                <TextBlock Margin="24,7,0,0"
                                           MaxWidth="360"
                                           HorizontalAlignment="Left"
                                           Foreground="#9A5B13"
                                           FontSize="11"
                                           TextWrapping="NoWrap"
                                           Text="{loc:Loc Settings_AudioLanguageMissing}"
                                           IsEnabled="{Binding IsChecked, ElementName=FilterAudioTracksByLanguageCheckBox}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{loc:Loc Settings_TabAssStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,12,4,0">
                    <Border Style="{StaticResource SectionCardStyle}"
                            VerticalAlignment="Top">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="UseCustomAssStyleCheckBox"
                                          VerticalAlignment="Center"
                                          Content="{loc:Loc Settings_UseAssStyle}" />
                                <Button x:Name="AssStyleDetailsToggleButton"
                                        Grid.Column="1"
                                        Width="36"
                                        Height="30"
                                        Padding="0"
                                        ToolTip="{loc:Loc Settings_ExpandAssStyle}"
                                        Margin="14,0,0,0"
                                        Click="ToggleAssStyleDetails_Click">
                                    <Path Width="10"
                                          Height="6"
                                          Data="M 1 1 L 5 5 L 9 1"
                                          Stroke="#323130"
                                          StrokeThickness="1.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Stretch="None"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <RotateTransform x:Name="AssStyleDetailsArrowTransform" />
                                        </Path.RenderTransform>
                                    </Path>
                                </Button>
                            </Grid>

                            <Border x:Name="AssStyleDetailsPanel"
                                    Grid.Row="1"
                                    Margin="0,14,0,0"
                                    Padding="0,14,0,0"
                                    BorderBrush="#E1E1E1"
                                    BorderThickness="0,1,0,0"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc Settings_AssStyleDetails}"
                                                       FontSize="17"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Margin="0,3,16,0"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Text="{loc:Loc Settings_AssStyleDetailsHelp}" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="{loc:Loc Settings_ManualStyleInput}"
                                                Margin="0"
                                                VerticalAlignment="Center"
                                                Click="OpenManualStyleInput_Click" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Style="{StaticResource AssFieldContainerStyle}">
                                            <TextBlock Text="PlayResX" Style="{StaticResource AssFieldLabelStyle}" />
                                            <TextBox x:Name="PlayResXTextBox" Style="{StaticResource AssFieldTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2" Style="{StaticResource AssFieldContainerStyle}">
                                            <TextBlock Text="PlayResY" Style="{StaticResource AssFieldLabelStyle}" />
                                            <TextBox x:Name="PlayResYTextBox" Style="{StaticResource AssFieldTextBoxStyle}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Style="{StaticResource AssFieldContainerStyle}">
                                            <TextBlock Text="{loc:Loc Ass_FontName}" Style="{StaticResource AssFieldLabelStyle}" />
                                            <TextBox x:Name="FontNameTextBox" Style="{StaticResource AssFieldTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2" Style="{StaticResource AssFieldContainerStyle}">
                                            <TextBlock Text="{loc:Loc Ass_FontSize}" Style="{StaticResource AssFieldLabelStyle}" />
                                            <TextBox x:Name="FontSizeTextBox" Style="{StaticResource AssFieldTextBoxStyle}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Style="{StaticResource AssFieldContainerStyle}">
                                            <TextBlock Text="{loc:Loc Ass_PrimaryColor}" Style="{StaticResource AssFieldLabelStyle}" />
                                            <TextBox x:Name="PrimaryColorTextBox" Style="{StaticResource AssFieldTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="2" Style="{StaticResource AssFieldContainerStyle}">
                                            <TextBlock Text="{loc:Loc Ass_OutlineColor}" Style="{StaticResource AssFieldLabelStyle}" />
                                            <TextBox x:Name="OutlineColorTextBox" Style="{StaticResource AssFieldTextBoxStyle}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Style="{StaticResource AssFieldContainerStyle}">
                                            <TextBlock Text="{loc:Loc Ass_BackColor}" Style="{StaticResource AssFieldLabelStyle}" />
                                            <TextBox x:Name="BackColorTextBox" Style="{StaticResource AssFieldTextBoxStyle}" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       FontSize="11"
                                                       Text="{loc:Loc Ass_ColorFormat}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="4" Style="{StaticResource AssFieldContainerStyle}">
                                            <TextBlock Text="{loc:Loc Ass_OutlineWidth}" Style="{StaticResource AssFieldLabelStyle}" />
                                            <TextBox x:Name="OutlineWidthTextBox" Style="{StaticResource AssFieldTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="4" Grid.Column="2" Style="{StaticResource AssFieldContainerStyle}">
                                            <TextBlock Text="{loc:Loc Ass_ShadowDepth}" Style="{StaticResource AssFieldLabelStyle}" />
                                            <TextBox x:Name="ShadowDepthTextBox" Style="{StaticResource AssFieldTextBoxStyle}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="5" Style="{StaticResource AssFieldContainerStyle}">
                                            <TextBlock Text="{loc:Loc Ass_Alignment}" Style="{StaticResource AssFieldLabelStyle}" />
                                            <ComboBox x:Name="AlignmentComboBox" Style="{StaticResource AssFieldComboBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="5" Grid.Column="2" Style="{StaticResource AssFieldContainerStyle}">
                                            <TextBlock Text="{loc:Loc Ass_MarginVertical}" Style="{StaticResource AssFieldLabelStyle}" />
                                            <TextBox x:Name="MarginVerticalTextBox" Style="{StaticResource AssFieldTextBoxStyle}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="6" Style="{StaticResource AssFieldContainerStyle}">
                                            <TextBlock Text="{loc:Loc Ass_MarginLeft}" Style="{StaticResource AssFieldLabelStyle}" />
                                            <TextBox x:Name="MarginLeftTextBox" Style="{StaticResource AssFieldTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="6" Grid.Column="2" Style="{StaticResource AssFieldContainerStyle}">
                                            <TextBlock Text="{loc:Loc Ass_MarginRight}" Style="{StaticResource AssFieldLabelStyle}" />
                                            <TextBox x:Name="MarginRightTextBox" Style="{StaticResource AssFieldTextBoxStyle}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="7" Grid.ColumnSpan="3" Orientation="Horizontal">
                                            <CheckBox x:Name="BoldCheckBox" Content="{loc:Loc Ass_Bold}" Margin="0,2,28,0" />
                                            <CheckBox x:Name="ItalicCheckBox" Content="{loc:Loc Ass_Italic}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{loc:Loc Settings_TabTools}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,12,4,0">
                    <StackPanel>
                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock Text="MKVToolNix" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Margin="0,4,0,10" Foreground="{StaticResource SecondaryTextBrush}" Text="mkvmerge.exe" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="MkvMergePathTextBox" Style="{StaticResource FieldTextBoxStyle}" Margin="0" />
                                    <Button Grid.Column="1" Content="{loc:Loc Settings_AutoDetect}" Margin="8,0,0,0" Click="AutoDetectMkvMerge_Click" />
                                    <Button Grid.Column="2" Content="{loc:Loc Common_Browse}" Margin="8,0,0,0" Click="BrowseMkvMerge_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Subtitle Edit seconv" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Margin="0,4,0,3"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Text="seconv.exe" />
                                <TextBlock Margin="0,0,0,10"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="{loc:Loc Settings_SeConvInstallNotice}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SeConvPathTextBox" Style="{StaticResource FieldTextBoxStyle}" Margin="0" />
                                    <Button Grid.Column="1" Content="{loc:Loc Settings_AutoDetect}" Margin="8,0,0,0" Click="AutoDetectSeConv_Click" />
                                    <Button Grid.Column="2" Content="{loc:Loc Common_Browse}" Margin="8,0,0,0" Click="BrowseSeConv_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="4,0,4,12"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="{loc:Loc Settings_ToolPathHelp}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="White" BorderBrush="#D1D1D1" BorderThickness="0,1,0,0" Padding="18,14">
            <Grid>
                <Button Content="{loc:Loc Settings_OpenFolder}"
                        HorizontalAlignment="Left"
                        Margin="0"
                        Click="OpenSettingsFolder_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{loc:Loc Common_Cancel}" IsCancel="True" />
                    <Button Content="{loc:Loc Common_Save}" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Click="SaveButton_Click" Margin="0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
