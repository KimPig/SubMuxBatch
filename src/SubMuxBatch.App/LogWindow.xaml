<Window x:Class="SubMuxBatch.App.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SubMux Batch 실행 로그"
        Width="920"
        Height="560"
        MinWidth="620"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="#F3F3F3"
        Foreground="#201F1E"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary Source="Win10DialogStyles.xaml" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="20,15"
                Background="White"
                BorderBrush="#D1D1D1"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="실행 로그" FontSize="21" FontWeight="SemiBold" />
                <TextBlock Margin="0,3,0,0"
                           Text="현재 세션의 작업 로그가 실시간으로 표시됩니다."
                           Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="16"
                Background="#111111"
                BorderBrush="#605E5C"
                BorderThickness="1"
                CornerRadius="2">
            <TextBox x:Name="LogTextBox"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="12"
                     Background="Transparent"
                     Foreground="#F3F2F1"
                     CaretBrush="#F3F2F1"
                     BorderThickness="0"
                     Padding="12" />
        </Border>

        <Border Grid.Row="2"
                Padding="16,10"
                Background="White"
                BorderBrush="#D1D1D1"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LogPathText"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="전체 복사" Click="CopyAllButton_Click" />
                    <Button Content="로그 폴더" Click="OpenLogFolderButton_Click" />
                    <Button Content="닫기" Click="CloseButton_Click" Margin="0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
