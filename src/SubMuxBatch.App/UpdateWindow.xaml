<Window x:Class="SubMuxBatch.App.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SubMux Batch"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#F3F3F3"
        Foreground="#201F1E"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Closing="Window_Closing">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Win10DialogStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="24,22,24,20">
            <TextBlock x:Name="HeadingText"
                       FontSize="21"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="DescriptionText"
                       Margin="0,9,0,0"
                       Foreground="#5C5C5C"
                       TextWrapping="Wrap" />

            <Border Margin="0,18,0,0"
                    Padding="14,12"
                    Background="White"
                    BorderBrush="#D1D1D1"
                    BorderThickness="1"
                    CornerRadius="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="CurrentVersionLabel" FontWeight="SemiBold" />
                    <TextBlock x:Name="CurrentVersionText" Grid.Column="1" Margin="18,0,0,0" />
                    <TextBlock x:Name="LatestVersionLabel" Grid.Row="1" Margin="0,8,0,0" FontWeight="SemiBold" />
                    <TextBlock x:Name="LatestVersionText" Grid.Row="1" Grid.Column="1" Margin="18,8,0,0" />
                </Grid>
            </Border>

            <StackPanel x:Name="ProgressPanel" Margin="0,18,0,0" Visibility="Collapsed">
                <TextBlock x:Name="ProgressStatusText" Margin="0,0,0,7" />
                <ProgressBar x:Name="DownloadProgressBar"
                             Height="7"
                             Minimum="0"
                             Maximum="100" />
            </StackPanel>

            <TextBlock x:Name="ErrorText"
                       Margin="0,16,0,0"
                       Foreground="#C42B1C"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />
        </StackPanel>

        <Border Grid.Row="1"
                Padding="18,12,10,12"
                Background="White"
                BorderBrush="#D1D1D1"
                BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="LaterButton" Click="LaterButton_Click" />
                <Button x:Name="UpdateButton"
                        Margin="0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="UpdateButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
