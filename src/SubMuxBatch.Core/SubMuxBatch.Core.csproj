<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="libse" Version="5.1.0" />
    <PackageReference Include="MediaInfoDLL" Version="26.1.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Localization\CoreStrings.en.json" LogicalName="SubMuxBatch.Core.Localization.CoreStrings.en.json" WithCulture="false" />
    <EmbeddedResource Include="Localization\CoreStrings.ko.json" LogicalName="SubMuxBatch.Core.Localization.CoreStrings.ko.json" WithCulture="false" />
    <EmbeddedResource Include="Resources\SubMuxSans-Medium.otf" LogicalName="SubMuxBatch.Core.Resources.SubMuxSans-Medium.otf" />
    <EmbeddedResource Include="Resources\SubMuxSans-OFL.txt" LogicalName="SubMuxBatch.Core.Resources.SubMuxSans-OFL.txt" />
    <EmbeddedResource Include="$(BundledFfmpegPath)"
                      LogicalName="SubMuxBatch.Core.Resources.ffmpeg.$(BundledFfmpegResourceRid).exe"
                      Condition="'$(BundledFfmpegPath)' != '' and Exists('$(BundledFfmpegPath)')" />
    <EmbeddedResource Include="$(BundledMkvMergePath)"
                      LogicalName="SubMuxBatch.Core.Resources.mkvtoolnix.mkvmerge.exe"
                      Condition="'$(BundledMkvMergePath)' != '' and Exists('$(BundledMkvMergePath)')" />
    <EmbeddedResource Include="$(BundledMkvExtractPath)"
                      LogicalName="SubMuxBatch.Core.Resources.mkvtoolnix.mkvextract.exe"
                      Condition="'$(BundledMkvExtractPath)' != '' and Exists('$(BundledMkvExtractPath)')" />
    <EmbeddedResource Include="$(BundledMkvLocaleKoPath)"
                      LogicalName="SubMuxBatch.Core.Resources.mkvtoolnix.locale.ko.LC_MESSAGES.mkvtoolnix.mo"
                      Condition="'$(BundledMkvLocaleKoPath)' != '' and Exists('$(BundledMkvLocaleKoPath)')" />
    <EmbeddedResource Include="$(BundledLapseExePath)"
                      LogicalName="SubMuxBatch.Core.Resources.lapse.lapse.exe"
                      Condition="'$(BundledLapseExePath)' != '' and Exists('$(BundledLapseExePath)')" />
    <EmbeddedResource Include="$(BundledLapseOnnxRuntimePath)"
                      LogicalName="SubMuxBatch.Core.Resources.lapse.onnxruntime.dll"
                      Condition="'$(BundledLapseOnnxRuntimePath)' != '' and Exists('$(BundledLapseOnnxRuntimePath)')" />
    <EmbeddedResource Include="$(BundledLapseModelPath)"
                      LogicalName="SubMuxBatch.Core.Resources.lapse.silero_vad.onnx"
                      Condition="'$(BundledLapseModelPath)' != '' and Exists('$(BundledLapseModelPath)')" />
    <EmbeddedResource Include="$(BundledLapseLicensePath)"
                      LogicalName="SubMuxBatch.Core.Resources.lapse.LICENSE.txt"
                      Condition="'$(BundledLapseLicensePath)' != '' and Exists('$(BundledLapseLicensePath)')" />
    <EmbeddedResource Include="..\..\licenses\MKVToolNix-GPL-2.0.txt"
                      LogicalName="SubMuxBatch.Core.Resources.mkvtoolnix.COPYING.txt"
                      Condition="Exists('..\..\licenses\MKVToolNix-GPL-2.0.txt')" />
  </ItemGroup>
</Project>
