<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="libse" Version="5.1.0" />
    <PackageReference Include="MediaInfoDLL" Version="26.1.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Localization\CoreStrings.en.json" LogicalName="SubMuxBatch.Core.Localization.CoreStrings.en.json" WithCulture="false" />
    <EmbeddedResource Include="Localization\CoreStrings.ko.json" LogicalName="SubMuxBatch.Core.Localization.CoreStrings.ko.json" WithCulture="false" />
    <EmbeddedResource Include="Resources\SubMuxSans-Medium.otf" LogicalName="SubMuxBatch.Core.Resources.SubMuxSans-Medium.otf" />
    <EmbeddedResource Include="Resources\SubMuxSans-OFL.txt" LogicalName="SubMuxBatch.Core.Resources.SubMuxSans-OFL.txt" />
    <EmbeddedResource Include="$(BundledFfmpegPath)"
                      LogicalName="SubMuxBatch.Core.Resources.ffmpeg.$(BundledFfmpegResourceRid).exe"
                      Condition="'$(BundledFfmpegPath)' != '' and Exists('$(BundledFfmpegPath)')" />
    <EmbeddedResource Include="$(BundledMkvMergePath)"
                      LogicalName="SubMuxBatch.Core.Resources.mkvtoolnix.mkvmerge.exe"
                      Condition="'$(BundledMkvMergePath)' != '' and Exists('$(BundledMkvMergePath)')" />
    <EmbeddedResource Include="$(BundledMkvExtractPath)"
                      LogicalName="SubMuxBatch.Core.Resources.mkvtoolnix.mkvextract.exe"
                      Condition="'$(BundledMkvExtractPath)' != '' and Exists('$(BundledMkvExtractPath)')" />
    <EmbeddedResource Include="$(BundledMkvLocaleKoPath)"
                      LogicalName="SubMuxBatch.Core.Resources.mkvtoolnix.locale.ko.LC_MESSAGES.mkvtoolnix.mo"
                      Condition="'$(BundledMkvLocaleKoPath)' != '' and Exists('$(BundledMkvLocaleKoPath)')" />
    <EmbeddedResource Include="$(BundledLapseExePath)"
                      LogicalName="SubMuxBatch.Core.Resources.lapse.lapse.exe"
                      Condition="'$(BundledLapseExePath)' != '' and Exists('$(BundledLapseExePath)')" />
    <EmbeddedResource Include="$(BundledLapseOnnxRuntimePath)"
                      LogicalName="SubMuxBatch.Core.Resources.lapse.onnxruntime.dll"
                      Condition="'$(BundledLapseOnnxRuntimePath)' != '' and Exists('$(BundledLapseOnnxRuntimePath)')" />
    <EmbeddedResource Include="$(BundledLapseModelPath)"
                      LogicalName="SubMuxBatch.Core.Resources.lapse.silero_vad.onnx"
                      Condition="'$(BundledLapseModelPath)' != '' and Exists('$(BundledLapseModelPath)')" />
    <EmbeddedResource Include="..\..\licenses\lapse\2.2.4\LAPSE-GPL-3.0-or-later.txt"
                      LogicalName="SubMuxBatch.Core.Resources.lapse.LICENSE.txt" />
    <EmbeddedResource Include="..\..\licenses\lapse\2.2.4\FFmpeg-LGPL-2.1-or-later.txt"
                      LogicalName="SubMuxBatch.Core.Resources.lapse.FFmpeg-LGPL-2.1-or-later.txt" />
    <EmbeddedResource Include="..\..\licenses\lapse\2.2.4\FFTW-GPL-2.0-or-later.txt"
                      LogicalName="SubMuxBatch.Core.Resources.lapse.FFTW-GPL-2.0-or-later.txt" />
    <EmbeddedResource Include="..\..\licenses\lapse\2.2.4\libfvad-BSD-3-Clause.txt"
                      LogicalName="SubMuxBatch.Core.Resources.lapse.libfvad-BSD-3-Clause.txt" />
    <EmbeddedResource Include="..\..\licenses\lapse\2.2.4\zlib-License.txt"
                      LogicalName="SubMuxBatch.Core.Resources.lapse.zlib-License.txt" />
    <EmbeddedResource Include="..\..\licenses\lapse\2.2.4\ONNX-Runtime-MIT.txt"
                      LogicalName="SubMuxBatch.Core.Resources.lapse.ONNX-Runtime-MIT.txt" />
    <EmbeddedResource Include="..\..\licenses\lapse\2.2.4\ONNX-Runtime-ThirdPartyNotices.txt"
                      LogicalName="SubMuxBatch.Core.Resources.lapse.ONNX-Runtime-ThirdPartyNotices.txt" />
    <EmbeddedResource Include="..\..\licenses\lapse\2.2.4\Silero-VAD-MIT.txt"
                      LogicalName="SubMuxBatch.Core.Resources.lapse.Silero-VAD-MIT.txt" />
    <EmbeddedResource Include="..\..\licenses\mkvtoolnix\102.0\COPYING.txt"
                      LogicalName="SubMuxBatch.Core.Resources.mkvtoolnix.COPYING.txt"
                      Condition="Exists('..\..\licenses\mkvtoolnix\102.0\COPYING.txt')" />
    <EmbeddedResource Include="..\..\licenses\mkvtoolnix\102.0\README.txt"
                      LogicalName="SubMuxBatch.Core.Resources.mkvtoolnix.README.txt" />
    <EmbeddedResource Include="..\..\licenses\mkvtoolnix\102.0\licenses\pugixml-MIT.txt"
                      LogicalName="SubMuxBatch.Core.Resources.mkvtoolnix.licenses.pugixml-MIT.txt" />
    <EmbeddedResource Include="..\..\licenses\mkvtoolnix\102.0\licenses\nlohmann-json-MIT.txt"
                      LogicalName="SubMuxBatch.Core.Resources.mkvtoolnix.licenses.nlohmann-json-MIT.txt" />
    <EmbeddedResource Include="..\..\licenses\mkvtoolnix\102.0\licenses\QtWaitingSpinner-MIT.txt"
                      LogicalName="SubMuxBatch.Core.Resources.mkvtoolnix.licenses.QtWaitingSpinner-MIT.txt" />
    <EmbeddedResource Include="..\..\licenses\mkvtoolnix\102.0\licenses\LGPL-3.0.txt"
                      LogicalName="SubMuxBatch.Core.Resources.mkvtoolnix.licenses.LGPL-3.0.txt" />
    <EmbeddedResource Include="..\..\licenses\mkvtoolnix\102.0\licenses\LGPL-2.1.txt"
                      LogicalName="SubMuxBatch.Core.Resources.mkvtoolnix.licenses.LGPL-2.1.txt" />
    <EmbeddedResource Include="..\..\licenses\mkvtoolnix\102.0\licenses\CC-BY-3.0.txt"
                      LogicalName="SubMuxBatch.Core.Resources.mkvtoolnix.licenses.CC-BY-3.0.txt" />
    <EmbeddedResource Include="..\..\licenses\mkvtoolnix\102.0\licenses\Boost-1.0.txt"
                      LogicalName="SubMuxBatch.Core.Resources.mkvtoolnix.licenses.Boost-1.0.txt" />
  </ItemGroup>
</Project>
